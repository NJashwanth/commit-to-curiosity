{
  "name": "digit-sketch",
  "version": "0.1.0",
  "private": true,
  "description": "A browser handwritten digit recognizer. A CNN trained in PyTorch runs on a from-scratch TypeScript inference engine: no ML libraries.",
  "author": "Jashwanth Neela",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
