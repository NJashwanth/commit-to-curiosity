{
  "name": "git-wrapped",
  "version": "0.1.0",
  "private": true,
  "description": "A Spotify Wrapped style year in review for any GitHub user, as one self-contained HTML file.",
  "author": "Jashwanth Neela",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
