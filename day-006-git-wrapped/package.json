{
  "name": "git-wrapped",
  "version": "0.1.0",
  "private": true,
  "description": "A Spotify Wrapped style year in review for any GitHub user, as one self-contained HTML file.",
  "author": "Jashwanth Neela",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
