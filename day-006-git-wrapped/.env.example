# Copy to .env and fill in.

# Required. A GitHub token with read-only scope is enough (a fine-grained token
# with public repo read access, or a classic token with no scopes ticked).
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# Optional. If set, Claude writes the one-liner on each slide.
# Without it (or with --no-ai) the slides use template lines.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Optional: override the model used for narration.
# GIT_WRAPPED_MODEL=claude-haiku-5-5
