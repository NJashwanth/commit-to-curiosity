> CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER, score REAL);
Table users created.
> INSERT INTO users VALUES (1, 'Jash', 27, 98.5);
1 row inserted.
> INSERT INTO users VALUES (2, 'Ada', 36, 91.0), (3, 'Linus', 54, 77.25), (4, 'Grace', 45, NULL);
