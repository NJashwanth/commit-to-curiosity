{
  "name": "autograd-playground",
  "version": "0.1.0",
  "private": true,
  "description": "A scalar autograd engine and tiny neural net library in TypeScript, with a browser playground for training on toy datasets and a computation graph viewer.",
  "author": "Jashwanth Neela",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "train:all": "tsx tools/train-all.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
