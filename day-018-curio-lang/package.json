{
  "name": "curio-lang",
  "version": "0.1.0",
  "private": true,
  "description": "Curio, a small dynamic programming language written in TypeScript: lexer, Pratt parser, tree-walking interpreter, CLI, REPL and a browser playground.",
  "author": "Jashwanth Neela",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
